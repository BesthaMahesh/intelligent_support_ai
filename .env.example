# ============================================================
# Intelligent Support AI - Example Configuration
# ============================================================

APP_NAME="Intelligent Support AI"
APP_ENV="production"
DEBUG=False
PORT=8000
FRONTEND_PORT=8501

# LLM Providers (groq | openai | gemini | mock)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Security & Authentication
SECRET_KEY=your_secure_secret_key_minimum_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
DATABASE_URL=sqlite:///./data/support_ai.db

# RAG & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma_db
TOP_K_RETRIEVAL=4
RERANK_TOP_K=3

# Guardrails
ENABLE_GUARDRAILS=True
MAX_INPUT_CHARS=2000
CONFIDENCE_THRESHOLD=0.65

# Cost Tracking
INR_PER_USD=86.50
GROQ_INPUT_COST_PER_1K=0.005
GROQ_OUTPUT_COST_PER_1K=0.007

# LangSmith Observability (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=intelligent-support-ai
